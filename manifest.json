{
  "manifest_version": 3,
  "name": "Gladiators Battle Monitor",
  "version": "1.0",
  "description": "Мониторит страницу ожидания боя в игре Gladiators и уведомляет о начале боя.",
  "permissions": [
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://gladiators.ru/*",
    "https://www.gladiators.ru/*",
    "https://s2.gladiators.ru/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gladiators.ru/*",
        "https://www.gladiators.ru/*",
        "https://s2.gladiators.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/battle-start.mp3"],
      "matches": ["https://gladiators.ru/*", "https://www.gladiators.ru/*", "https://s2.gladiators.ru/*"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
